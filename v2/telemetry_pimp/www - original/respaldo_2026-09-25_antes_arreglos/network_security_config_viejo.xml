<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP plano permitido: hace falta para hablar con el Sender
         por WiFi local (ver docs/CLAUDE.md, sección "Comunicación con
         el datalogger"). El Sender no tiene IP fija conocida de
         antemano, así que se habilita para toda la red local. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
    </domain-config>
</network-security-config>
