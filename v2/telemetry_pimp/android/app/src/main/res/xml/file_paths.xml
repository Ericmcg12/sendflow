<?xml version="1.0" encoding="utf-8"?>
<!-- Rutas que el FileProvider de la app puede compartir por content:// URI.
     Se amplió (sin sacar nada) para cubrir también la carpeta donde se
     guarda la foto temporal de la cámara al elegir "sacar foto" en Perfil
     (ver MainActivity.java, lanzarSelectorArchivos()). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="my_images" path="Pictures" />
    <external-files-path name="my_movies" path="Movies" />
    <cache-path name="my_cache" path="." />
    <external-cache-path name="my_external_cache" path="." />
    <files-path name="my_files" path="." />
    <external-path name="my_external_files" path="." />
</paths>
