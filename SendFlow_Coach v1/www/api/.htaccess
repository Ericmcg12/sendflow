# SendFlow Coach — protege la configuración y las librerías de la API
<FilesMatch "^(config\.php|config\.ejemplo\.php)$">
  Require all denied
</FilesMatch>
# Deja pasar el encabezado Authorization a PHP (algunos hostings lo sacan)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>
# Subidas por partes de 2 MB: alcanza con los límites de fábrica
<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 16M
</IfModule>
